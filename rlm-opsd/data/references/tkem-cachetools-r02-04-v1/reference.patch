+def tlru_cache(ttu, maxsize=128, timer=time.monotonic, typed=False):
+    """Decorator to wrap a function with a memoizing callable that saves
+    up to `maxsize` results based on a Time aware Least Recently Used
+    (TLRU) algorithm.
+
+    The required `ttu(key, value, now)` callback receives the generated
+    cache key, the computed result, and the timer value at insertion,
+    and returns an absolute expiration deadline.  Results with deadlines
+    at or before `now` are returned but not cached.  Cache hits do not
+    call `ttu` again.
+
+    If `maxsize` is None, the cache is unbounded but results still expire.
+
+    """
+    if maxsize is None:
+        return _cache(_UnboundTLRUCache(ttu, timer), None, typed)
+    else:
+        return _cache(TLRUCache(maxsize, ttu, timer), maxsize, typed)
+
