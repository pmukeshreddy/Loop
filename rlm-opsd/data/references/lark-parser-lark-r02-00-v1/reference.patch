+def resolve_term_references(term_dict, validate_declares=True):
+    # Inspect dependencies before inlining mutates the trees. In particular,
+    # start at outermost terminals so diagnostics don't depend on definition
+    # order.
+    dependencies = {}
+    dependents = {name: set() for name in term_dict}
+    for name, tree in term_dict.items():
+        dependencies[name] = []
+        if tree is not None:
+            for exp in tree.find_data('value'):
+                item, = exp.children
+                if isinstance(item, Terminal):
+                    dependencies[name].append(item.name)
+                    if item.name in dependents:
+                        dependents[item.name].add(name)
+
+    # Imports are resolved before the importing grammar has been loaded.
+    # Leave references leading to declarations intact until we can report
+    # the outermost terminal using the final, mangled names.
+    unresolved = {name for name, tree in term_dict.items() if tree is None}
+    pending = list(unresolved)
+    while pending:
+        for name in dependents[pending.pop()]:
+            if name not in unresolved:
+                unresolved.add(name)
+                pending.append(name)
+
+    if validate_declares:
+        roots = [name for name in term_dict if not dependents[name]]
+        for name in roots + list(term_dict):
+            if term_dict[name] is None or name not in unresolved:
+                continue
+            seen = set()
+            pending = [name]
+            while pending:
+                dependency = pending.pop()
+                if dependency in seen or dependency not in term_dict:
+                    continue
+                seen.add(dependency)
+                if term_dict[dependency] is None:
+                    raise GrammarError(
+                        "Terminal %s depends on declared terminal %s, which has no pattern"
+                        % (name, dependency)
+                    )
+                pending.extend(dependencies[dependency])
 
