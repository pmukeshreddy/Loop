  "hidden_tests_patch": "--- /dev/null\n+++ b/tests/test_outgoing_extra_validation.py\n@@ -0,0 +1,130 @@\n+import logging\n+\n+from unittest.mock import patch\n+\n+import pytest\n+\n+from structlog.stdlib import (\n+    BoundLogger,\n+    render_to_log_args_and_kwargs,\n+    render_to_log_kwargs,\n+)\n+\n+\n+RENDERERS = [render_to_log_kwargs, render_to_log_args_and_kwargs]\n+RESERVED_EXTRAS = sorted(\n+    (\n+        set(logging.LogRecord(\"n\", 0, \"p\", 0, \"m\", (), None).__dict__)\n+        | {\"message\", \"asctime\"}\n+    )\n+    - {\"exc_info\", \"stack_info\", \"stacklevel\"}\n+)\n+\n+\n+@pytest.mark.parametrize(\"renderer\", RENDERERS)\n+@pytest.mark.parametrize(\"key\", RESERVED_EXTRAS)\n+@pytest.mark.parametrize(\"value\", [None, False, \"\"])\n+def test_rejected_extra_leaves_input_intact(renderer, key, value):\n+    ed = {\n+        \"event\": \"hello %s\",\n+        \"positional_args\": (\"world\",),\n+        \"exc_info\": False,\n+        \"stack_info\": False,\n+        \"stacklevel\": 2,\n+        \"custom\": [],\n+        key: value,\n+    }\n+    before = list(ed.items())\n+\n+    with pytest.raises(KeyError) as error:\n+        renderer(None, \"info\", ed)\n+\n+    assert key in str(error.value)\n+    assert before == list(ed.items())\n+    for name, original in before:\n+        assert ed[name] is original\n+\n+\n+@pytest.mark.parametrize(\"renderer\", RENDERERS)\n+@pytest.mark.parametrize(\"key\", [\"name\", \"levelname\", \"message\", \"asctime\"])\n+def test_bound_logger_rejects_before_backend_call(renderer, key):\n+    logger = logging.Logger(\"outgoing\", logging.INFO)\n+    captured = []\n+\n+    def capture(_, __, ed):\n+        captured.append((ed, list(ed.items())))\n+        return ed\n+\n+    bl = BoundLogger(logger, [capture, renderer], {\"custom\": \"bound\"})\n+    with patch.object(logger, \"info\") as backend:\n+        with pytest.raises(KeyError) as error:\n+            bl.info(\"hello %s\", \"world\", **{key: \"invalid\"})\n+\n+    assert key in str(error.value)\n+    backend.assert_not_called()\n+    ed, before = captured[0]\n+    assert list(ed.items()) == before\n+\n+\n+@pytest.mark.parametrize(\"renderer\", RENDERERS)\n+def test_success_retains_consumption_and_extra_identity(renderer):\n+    ed = {\n+        \"event\": \"hello %s\",\n+        \"positional_args\": (\"world\",),\n+        \"exc_info\": False,\n+        \"stack_info\": True,\n+        \"stacklevel\": 3,\n+        \"stackLevel\": 4,\n+        \"extra\": {\"name\": \"nested is ordinary data\"},\n+    }\n+    if renderer is render_to_log_kwargs:\n+        kw = renderer(None, \"info\", ed)\n+        assert kw[\"msg\"] == \"hello %s\"\n+        assert ed[\"positional_args\"] == (\"world\",)\n+    else:\n+        args, kw = renderer(None, \"info\", ed)\n+        assert args == (\"hello %s\", \"world\")\n+        assert \"positional_args\" not in ed\n+    assert kw[\"extra\"] is ed\n+    assert kw[\"exc_info\"] is False\n+    assert kw[\"stack_info\"] is True\n+    assert kw[\"stacklevel\"] == 3\n+    assert ed[\"stackLevel\"] == 4\n+    assert ed[\"extra\"] == {\"name\": \"nested is ordinary data\"}\n+    assert not {\"event\", \"exc_info\", \"stack_info\", \"stacklevel\"} & ed.keys()\n+\n+\n+@pytest.mark.parametrize(\"renderer\", RENDERERS)\n+def test_bound_logger_successful_dispatch(renderer):\n+    logger = logging.Logger(\"outgoing\", logging.INFO)\n+    bl = BoundLogger(logger, [renderer], {\"custom\": 42})\n+    with patch.object(logger, \"_log\") as backend:\n+        bl.info(\n+            \"hello %s\", \"world\", exc_info=False, stack_info=True, stacklevel=3\n+        )\n+    extra = {\"custom\": 42}\n+    args = (\"world\",)\n+    if renderer is render_to_log_kwargs:\n+        extra[\"positional_args\"] = args\n+        args = ()\n+    backend.assert_called_once_with(\n+        logging.INFO,\n+        \"hello %s\",\n+        args,\n+        exc_info=False,\n+        stack_info=True,\n+        stacklevel=3,\n+        extra=extra,\n+    )\n+\n+\n+@pytest.mark.parametrize(\"renderer\", RENDERERS)\n+def test_empty_extra_shape(renderer):\n+    ed = {\"event\": \"hello\"}\n+    if renderer is render_to_log_kwargs:\n+        assert renderer(None, \"info\", ed) == {\"msg\": \"hello\", \"extra\": {}}\n+    else:\n+        assert renderer(None, \"info\", ed) == ((\"hello\",), {})\n+    assert ed == {}\n",
