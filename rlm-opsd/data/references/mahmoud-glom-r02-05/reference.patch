+    def clone(self):
+        """Return an independently configurable snapshot of this Glommer.
+
+        The clone starts with the same effective scope values and target
+        registrations, including custom operation autodiscovery. Scope and
+        registration changes on either instance do not affect the other.
+        Scope values and handler callables themselves remain shared references;
+        they are not deep-copied.
+        """
+        ret = copy.copy(self)
+        ret.scope = ChainMap(dict(self.scope))
+        ret.scope[TargetRegistry] = self.scope[TargetRegistry]._clone()
+        return ret
