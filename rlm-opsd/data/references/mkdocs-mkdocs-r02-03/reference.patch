+def _yaml_load(
+    source: IO | str, loader: type[yaml.BaseLoader], active_paths: tuple[str, ...]
+) -> dict[str, Any]:
+    # Track only this inheritance chain, not other (independent) loads. Real
+    # paths ensure that a symlink alias of an active file also closes a cycle.
+    name = getattr(source, 'name', None)
+    if not isinstance(source, str) and isinstance(name, (str, bytes, os.PathLike)):
+        path = os.path.normcase(os.path.realpath(os.path.abspath(os.fsdecode(name))))
+        if path in active_paths:
+            cycle = active_paths[active_paths.index(path) :] + (path,)
+            raise exceptions.ConfigurationError(
+                f"INHERIT cycle detected: {' -> '.join(cycle)}"
+            )
+        active_paths += (path,)
+
