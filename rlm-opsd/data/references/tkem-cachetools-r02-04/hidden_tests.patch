--- /dev/null
+++ b/tests/test_cache_if.py
@@ -0,0 +1,145 @@
+import threading
+import warnings
+
+import pytest
+
+from cachetools import Cache, cached, cachedmethod
+
+
+class ConditionProbe:
+    def __init__(self):
+        self.lock = threading.RLock()
+        self.notifications = 0
+
+    def __enter__(self):
+        return self.lock.__enter__()
+
+    def __exit__(self, *args):
+        return self.lock.__exit__(*args)
+
+    def wait_for(self, predicate):
+        assert predicate(), "a completed call left its key pending"
+        return True
+
+    def notify_all(self):
+        self.notifications += 1
+
+
+def build(kind, mode, info, predicate, storage=None):
+    storage = {} if storage is None else storage
+    sync = ConditionProbe()
+    calls = []
+    lock = sync if mode == "locked" else None
+    cond = sync if mode == "condition" else None
+    if kind == "function":
+        @cached(storage, lock=lock, condition=cond, info=info, cache_if=predicate)
+        def wrapper(value):
+            calls.append(value)
+            return value
+    else:
+        class Receiver:
+            @cachedmethod(
+                lambda self: storage,
+                lock=(lambda self: lock) if lock is not None else None,
+                condition=(lambda self: cond) if cond is not None else None,
+                info=info,
+                cache_if=predicate,
+            )
+            def call(self, value):
+                calls.append(value)
+                return value
+        wrapper = Receiver().call
+    return wrapper, calls, storage, sync
+
+
+@pytest.mark.parametrize("kind", ["function", "method"])
+@pytest.mark.parametrize("mode", ["unlocked", "locked", "condition"])
+@pytest.mark.parametrize("info", [False, True])
+def test_rejected_results_are_misses(kind, mode, info):
+    seen = []
+
+    def predicate(value):
+        seen.append(value)
+        return value % 2 == 0
+
+    wrapper, calls, storage, sync = build(kind, mode, info, predicate)
+    assert [wrapper(x) for x in (1, 1, 2, 2)] == [1, 1, 2, 2]
+    assert calls == [1, 1, 2]
+    assert seen == [1, 1, 2]
+    assert len(storage) == 1
+    if info:
+        assert wrapper.cache_info() == (1, 3, None, 1)
+    if mode == "condition":
+        assert sync.notifications == 3
+
+
+@pytest.mark.parametrize("kind", ["function", "method"])
+@pytest.mark.parametrize("mode", ["unlocked", "locked", "condition"])
+@pytest.mark.parametrize("info", [False, True])
+def test_predicate_exception_does_not_poison_key(kind, mode, info):
+    seen = []
+
+    def predicate(value):
+        seen.append(value)
+        if len(seen) == 1:
+            raise RuntimeError("predicate failed")
+        return True
+
+    wrapper, calls, storage, sync = build(kind, mode, info, predicate)
+    with pytest.raises(RuntimeError, match="predicate failed"):
+        wrapper(42)
+    assert not storage
+    assert wrapper(42) == 42
+    assert wrapper(42) == 42
+    assert calls == [42, 42]
+    assert seen == [42, 42]
+    if info:
+        assert wrapper.cache_info() == (1, 2, None, 1)
+    if mode == "condition":
+        assert sync.notifications == 2
+
+
+@pytest.mark.parametrize("kind", ["function", "method"])
+@pytest.mark.parametrize("mode", ["unlocked", "locked", "condition"])
+def test_oversized_values_remain_uncached(kind, mode):
+    wrapper, calls, storage, _ = build(kind, mode, True, lambda value: True, Cache(0))
+    assert wrapper(7) == wrapper(7) == 7
+    assert calls == [7, 7]
+    assert wrapper.cache_info() == (0, 2, 0, 0)
+
+
+def test_uncached_function_bypasses_predicate():
+    seen = []
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", DeprecationWarning)
+        wrapper = cached(None, info=True, cache_if=lambda value: seen.append(value))(
+            lambda value: value
+        )
+    assert wrapper(3) == wrapper(3) == 3
+    assert seen == []
+    assert wrapper.cache_info() == (0, 2, 0, 0)
+
+
+@pytest.mark.parametrize("kind", ["function", "method"])
+@pytest.mark.parametrize("info", [False, True])
+def test_locked_path_still_prefers_cached_result(kind, info):
+    holder = {}
+    def predicate(value):
+        wrapper = holder["wrapper"]
+        wrapper.cache[wrapper.cache_key(value)] = 99
+        return True
+    wrapper, calls, storage, _ = build(kind, "locked", info, predicate)
+    holder["wrapper"] = wrapper
+    assert wrapper(2) == 99
+    assert calls == [2]
+    assert wrapper(2) == 99
+    if info:
+        assert wrapper.cache_info() == (1, 1, None, 1)
+
+
+@pytest.mark.parametrize("kind", ["function", "method"])
+@pytest.mark.parametrize("mode", ["unlocked", "locked", "condition"])
+def test_none_predicate_keeps_default(kind, mode):
+    wrapper, calls, storage, _ = build(kind, mode, True, None)
+    assert wrapper(8) == wrapper(8) == 8
+    assert calls == [8]
