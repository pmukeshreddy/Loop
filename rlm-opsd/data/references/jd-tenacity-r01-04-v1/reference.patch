+def _is_async_retry(retry: RetryBaseT) -> bool:
+    # A synchronous composite may conceal asynchronous strategies at any depth.
+    if isinstance(retry, (retry_any, retry_all)):
+        return any(_is_async_retry(child) for child in retry.retries)
+    return inspect.iscoroutinefunction(retry) or inspect.iscoroutinefunction(
+        getattr(retry, "__call__", None)
+    )
+
+
+def _combine_retries(
+    left: RetryBaseT,
+    right: RetryBaseT,
+    operator: type["retry_any"] | type["retry_all"],
+) -> retry_base:
+    if _is_async_retry(left) or _is_async_retry(right):
+        # Import lazily: the asyncio retry module itself imports retry_base.
+        from tenacity.asyncio.retry import retry_all as async_retry_all
+        from tenacity.asyncio.retry import retry_any as async_retry_any
+
+        if operator is retry_any:
+            return async_retry_any(left, right)
+        return async_retry_all(left, right)
+
+    # Flatten only the same operator, never across an AND/OR boundary.
+    left_retries = left.retries if isinstance(left, operator) else (left,)
+    right_retries = right.retries if isinstance(right, operator) else (right,)
+    return operator(*left_retries, *right_retries)
 
 
