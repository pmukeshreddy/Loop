+async def _evaluate_retry(retry: RetryBaseT, retry_state: "RetryCallState") -> bool:
+    # Do not call synchronous composites directly: their any/all would test
+    # coroutine objects for truth instead of awaiting their results.
+    if isinstance(retry, sync_retry_any):
+        return await retry_any(*retry.retries)(retry_state)
+    if isinstance(retry, sync_retry_all):
+        return await retry_all(*retry.retries)(retry_state)
+    result = retry(retry_state)
+    if inspect.isawaitable(result):
+        return await result
+    return result
 
 
