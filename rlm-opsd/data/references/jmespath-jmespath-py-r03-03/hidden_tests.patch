--- /dev/null
+++ b/tests/test_tuple_array_inputs.py
@@ -0,0 +1,70 @@
+import pytest
+import jmespath
+from jmespath import exceptions
+
+
+@pytest.mark.parametrize("expression, expected", [
+    ("[1]", 1),
+    ("[-1]", 2),
+    ("[0:2]", [3, 1]),
+    ("[::-1]", [2, 1, 3]),
+    ("[*]", [3, 1, 2]),
+    ("[?@ > `1`]", [3, 2]),
+    ("length(@)", 3),
+    ("reverse(@)", [2, 1, 3]),
+    ("sort(@)", [1, 2, 3]),
+    ("sum(@)", 6),
+    ("avg(@)", 2),
+    ("min(@)", 1),
+    ("max(@)", 3),
+    ("to_array(@)", [3, 1, 2]),
+    ("type(@)", "array"),
+    ("to_number(@)", None),
+])
+def test_tuple_sequence_operations(expression, expected):
+    result = jmespath.search(expression, (3, 1, 2))
+    assert result == expected
+    if isinstance(expected, list):
+        assert type(result) is list
+
+
+def test_nested_tuple_structure_and_exprefs():
+    data = {"items": ({"k": (2, 1)}, {"k": (4, 3)})}
+    assert jmespath.search("items[*].k[0]", data) == [2, 4]
+    assert jmespath.search("items[].k[]", data) == [2, 1, 4, 3]
+    assert jmespath.search("map(&k[1], items)", data) == [1, 3]
+    assert jmespath.search("sort_by(items, &k[1])", data) == list(data["items"])
+    assert jmespath.search("max_by(items, &k[0])", data) is data["items"][1]
+    assert jmespath.search("items", data) is data["items"]
+
+
+def test_tuple_truth_and_empty_arrays():
+    assert jmespath.search("@ || 'fallback'", ()) == "fallback"
+    assert jmespath.search("@ && 'rhs'", ()) == ()
+    assert jmespath.search("!@", ()) is True
+    assert jmespath.search("sort_by(@, &missing)", ()) == []
+    assert type(jmespath.search("sort_by(@, &missing)", ())) is list
+    assert jmespath.search("map(&@, @)", ()) == []
+    assert jmespath.search("avg(@)", ()) is None
+
+
+def test_tuple_validation():
+    assert jmespath.search("join('-', @)", ("a", "b")) == "a-b"
+    with pytest.raises(exceptions.JMESPathTypeError):
+        jmespath.search("sum(@)", (1, True))
+    with pytest.raises(exceptions.JMESPathTypeError):
+        jmespath.search("sort(@)", (1, "x"))
+    with pytest.raises(exceptions.JMESPathTypeError):
+        jmespath.search("keys(@)", ())
+
+
+def test_tuple_projection_null_elision_and_slice_fields():
+    data = ({"v": 1}, {"v": None}, {}, {"v": 2})
+    assert jmespath.search("[*].v", data) == [1, 2]
+    assert jmespath.search("[1:].v", data) == [2]
+    assert jmespath.search("[?`true`].v", data) == [1, 2]
+    assert jmespath.search("[*]", (None, 0, False, ())) == [0, False, ()]
+    assert jmespath.search("[]", ((1, 2), (3,), 4)) == [1, 2, 3, 4]
+    assert jmespath.search("contains(@, `2`)", (1, 2)) is True
+    assert jmespath.search("min_by(@, &v)", data[:1]) is data[0]
+    assert jmespath.search("max_by(@, &v)", ()) is None
