from rlm_opsd.prompts import PromptConfig, ChatRenderer
from rlm_opsd.detectors.categories import classify_token_offsets
import json
config = PromptConfig.from_yaml()
renderer = ChatRenderer(config)
text = 'é🦉 hi\n```repl\nx = llm_query("é🦉") # comment\n```\nFINAL_VAR(x)'
encoded = renderer.tokenizer(text, add_special_tokens=False, return_offsets_mapping=True)
offsets = encoded['offset_mapping']
classified = classify_token_offsets(text, offsets)
assert len(encoded['input_ids']) == len(offsets) == len(classified)
assert {row['category'] for row in classified} == {'prose', 'code', 'comment', 'protocol'}
assert any(offsets[index] == offsets[index - 1] for index in range(1, len(offsets)))
assert text[0:1] == 'é' and text[1:2] == '🦉'
for row in classified:
    if text[row['start']:row['end']] in ['é', '🦉'] and row['start'] < 3:
        assert row['category'] == 'prose'
print('Standalone handcrafted fixture, tokenized once; no rollout suffix is re-tokenized.')
print('No model weights, inference, logprob calls, or model KL run.')
print(f'model={config.model_name} tokenizer_revision={config.revision}')
print(f'tokenizer_sha256={config.tokenizer_sha256}')
print(f'token_count={len(classified)}')
for token_id, row in zip(encoded['input_ids'], classified, strict=True):
    print(json.dumps(dict(token_id=token_id, **row, text=text[row['start']:row['end']]), ensure_ascii=False))
print('All asserted categories, token counts, and duplicate Unicode intervals passed.')
