43:     def forward(
44:         self,
45:         hidden_states: torch.Tensor,
46:         labels: torch.Tensor | None = None,
47:         temperature: Tensor | None = None,
48:     ) -> PrimeLmOutput:
49:         assert labels is not None, "FusedOutputLinear requires labels for chunked logprob computation"
50:         assert temperature is not None, "FusedOutputLinear requires per-token temperatures"
51: 
52:         b, s, h = hidden_states.shape
53:         hidden_states = hidden_states.reshape(b * s, h).contiguous()
54:         labels = labels.reshape(b * s).contiguous()
55:         inv_t = 1.0 / temperature.reshape(b * s).contiguous()  # [N]
56: 
57:         logprobs, entropy = _SequenceChunkedLogProbEntropyFn.apply(
58:             hidden_states, self.weight, labels, inv_t, self.chunk_size
59:         )
60: 
61:         logprobs = logprobs.reshape(b, s)
62:         entropy = entropy.reshape(b, s)
63:         return PrimeLmOutput(logprobs=logprobs, entropy=entropy)
