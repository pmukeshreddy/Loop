_setup_openai_client_from_resolved (config: verifiers.types.ClientConfig) -> openai.AsyncOpenAI /Users/mukeshreddy/Desktop/Refine deepswe/rlm-opsd/.venv/lib/python3.12/site-packages/verifiers/utils/client_utils.py 100 b961d4641bb342dcef6cf3aec275d0b6f1f075517bc035aca552a4bab042e996
def _setup_openai_client_from_resolved(config: ClientConfig) -> AsyncOpenAI:
    headers, api_key = _build_headers_and_api_key(config)
    return AsyncOpenAI(
        api_key=api_key or "EMPTY",
        base_url=config.api_base_url,
        max_retries=config.max_retries,
        http_client=_build_http_client(config, headers),
    )

_build_headers_and_api_key (config: verifiers.types.ClientConfig) -> tuple[dict[str, str], str | None] /Users/mukeshreddy/Desktop/Refine deepswe/rlm-opsd/.venv/lib/python3.12/site-packages/verifiers/utils/client_utils.py 61 b961d4641bb342dcef6cf3aec275d0b6f1f075517bc035aca552a4bab042e996
def _build_headers_and_api_key(
    config: ClientConfig,
) -> tuple[dict[str, str], str | None]:
    headers = dict(config.extra_headers)
    api_key = os.getenv(config.api_key_var)

    if config.api_key_var == "PRIME_API_KEY":
        prime_config = load_prime_config()
        if not api_key:
            api_key = prime_config.get("api_key", "")
        team_id = os.getenv("PRIME_TEAM_ID") or prime_config.get("team_id")
        if team_id:
            headers["X-Prime-Team-ID"] = team_id

    return headers, api_key

normalize_messages (value: str | collections.abc.Sequence[verifiers.types.SystemMessage | verifiers.types.UserMessage | verifiers.types.AssistantMessage | verifiers.types.ToolMessage | verifiers.types.TextMessage | collections.abc.Mapping[str, object]], *, field_name: str = 'messages') -> list[verifiers.types.SystemMessage | verifiers.types.UserMessage | verifiers.types.AssistantMessage | verifiers.types.ToolMessage | verifiers.types.TextMessage] /Users/mukeshreddy/Desktop/Refine deepswe/rlm-opsd/.venv/lib/python3.12/site-packages/verifiers/utils/message_utils.py 128 08c1c4e3ee17461764ed9af625036ff3c63aceee3b5dca4a7582407c8884fe35
def normalize_messages(
    value: MessageInput, *, field_name: str = "messages"
) -> Messages:
    """Normalize raw/string message inputs into provider-agnostic Message objects."""
    if isinstance(value, str):
        return [TextMessage(content=value)]
    normalized: Messages = []
    for message in value:
        if isinstance(message, dict):
            normalized.append(from_raw_message(dict(message)))
            continue
        if hasattr(message, "role") and hasattr(message, "content"):
            normalized.append(cast(Message, message))
            continue
        raise TypeError(
            f"Invalid {field_name} item type: {type(message).__name__}. "
            "Expected vf.Message-like objects."
        )
    return normalized

